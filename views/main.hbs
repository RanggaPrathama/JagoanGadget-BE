<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{appName}} — Backend API for NestJS starter">
    <meta name="theme-color" content="#0a0a0f">
    <title>{{pageTitle}} · {{appName}}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/main.css">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
</head>
<body>

    <!-- Ambient BG -->
    <div class="ambient" aria-hidden="true">
        <div class="ambient-orbe ambient-orbe--1"></div>
        <div class="ambient-orbe ambient-orbe--2"></div>
        <div class="ambient-orbe ambient-orbe--3"></div>
        <div class="ambient-grid"></div>
    </div>

    <!-- Navbar -->
    <nav class="navbar" role="navigation" aria-label="Main navigation">
        <div class="navbar-inner">
            <a href="/" class="navbar-brand">
                <svg class="navbar-logo" viewBox="0 0 36 36" fill="none" aria-hidden="true">
                    <rect width="36" height="36" rx="10" fill="url(#logo-grad)"/>
                    <path d="M9 14h18M9 18h14M9 22h10" stroke="white" stroke-width="2.8" stroke-linecap="round"/>
                    <defs>
                        <linearGradient id="logo-grad" x1="0" y1="0" x2="36" y2="36">
                            <stop offset="0%" stop-color="#6c5ce7"/>
                            <stop offset="100%" stop-color="#a29bfe"/>
                        </linearGradient>
                    </defs>
                </svg>
                <span class="navbar-name">{{appName}}</span>
                <span class="navbar-badge">v{{nestVersion}}</span>
            </a>
            <div class="navbar-links">
                <a href="/api/auth/status" class="navbar-link" target="_blank" rel="noopener">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
                    Auth
                </a>
                <a href="/api/me/permissions" class="navbar-link" target="_blank" rel="noopener">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    RBAC
                </a>
                <a href="https://github.com/RanggaPrathama" class="navbar-link navbar-link--icon" target="_blank" rel="noopener" aria-label="GitHub">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
                </a>
            </div>
        </div>
    </nav>

    <!-- Page Content -->
    <main class="main" role="main">
        {{{body}}}
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="footer-inner">
            <div class="footer-info">
                <span class="footer-copy">&copy; {{year}} <strong>{{appName}}</strong></span>
                <span class="footer-dot">·</span>
                <span class="footer-built">Built by <a href="https://github.com/RanggaPrathama" target="_blank" rel="noopener">Rangga Prathama</a></span>
            </div>
            <div class="footer-stack">
                <span class="footer-pill">NestJS {{nestVersion}}</span>
                <span class="footer-pill">TypeScript</span>
                <span class="footer-pill">PostgreSQL</span>
                <span class="footer-pill">Better Auth</span>
            </div>
        </div>
    </footer>

    <script src="/js/main.js"></script>
</body>
</html>
