<!-- Hero Section -->
<section class="hero">
    <div class="hero-bg" aria-hidden="true">
        <div class="hero-particles" id="particles"></div>
    </div>
    <div class="hero-content">
        <div class="hero-badge" data-reveal>⚡ Now Available</div>
        <h1 class="hero-title" data-reveal>
            Welcome to<br>
            <span class="hero-gradient">{{appName}}</span>
        </h1>
        <p class="hero-desc" data-reveal>
            Backend engine for <strong class="text-white">your project</strong> — secure, performant, and built for scale.
        </p>
        <div class="hero-actions" data-reveal>
            <a href="/api/auth/status" class="btn btn--primary" target="_blank" rel="noopener">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 3 21 3 21 8"/><line x1="4" y1="20" x2="21" y2="3"/></svg>
                Explore API
                <svg class="btn-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
            <a href="#endpoints" class="btn btn--ghost" data-scroll>
                View Endpoints
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </a>
        </div>
    </div>
</section>

<!-- Stats Bar -->
<section class="stats" data-reveal>
    <div class="stats-inner">
        <div class="stat-item">
            <span class="stat-value">6</span>
            <span class="stat-label">API Modules</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
            <span class="stat-value">PostgreSQL</span>
            <span class="stat-label">Database</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
            <span class="stat-value">RBAC</span>
            <span class="stat-label">Access Control</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
            <span class="stat-value">Better Auth</span>
            <span class="stat-label">Authentication</span>
        </div>
    </div>
</section>

<!-- Endpoints Section -->
<section class="endpoints" id="endpoints">
    <div class="section-head" data-reveal>
        <span class="section-tag">API Reference</span>
        <h2 class="section-title">Explore <span class="text-gradient">Modules</span></h2>
        <p class="section-desc">Every endpoint is secured, versioned, and documented.</p>
    </div>

    <div class="ep-grid">
        <a href="/api/auth/status" class="ep-card" data-reveal target="_blank" rel="noopener" style="--accent:#6c5ce7;--accent-bg:rgba(108,92,231,0.08)">
            <div class="ep-head">
                <div class="ep-icon" style="background:var(--accent-bg);color:var(--accent)">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
                </div>
                <div class="ep-method ep-method--get">GET</div>
            </div>
            <h3 class="ep-title">Authentication</h3>
            <p class="ep-desc">Session status, login state, and user identity via Better Auth.</p>
            <div class="ep-path">
                <span class="ep-path-text">/api/auth/status</span>
                <svg class="ep-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </div>
        </a>

        <a href="/api/me/permissions" class="ep-card" data-reveal target="_blank" rel="noopener" style="--accent:#00cec9;--accent-bg:rgba(0,206,201,0.08)">
            <div class="ep-head">
                <div class="ep-icon" style="background:var(--accent-bg);color:var(--accent)">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                </div>
                <div class="ep-method ep-method--get">GET</div>
            </div>
            <h3 class="ep-title">My Permissions</h3>
            <p class="ep-desc">Runtime permission cache — what the current user can access.</p>
            <div class="ep-path">
                <span class="ep-path-text">/api/me/permissions</span>
                <svg class="ep-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </div>
        </a>

        <a href="/api/admin/menus" class="ep-card" data-reveal target="_blank" rel="noopener" style="--accent:#fdcb6e;--accent-bg:rgba(253,203,110,0.08)">
            <div class="ep-head">
                <div class="ep-icon" style="background:var(--accent-bg);color:var(--accent)">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
                </div>
                <div class="ep-method ep-method--get">GET</div>
            </div>
            <h3 class="ep-title">Menus</h3>
            <p class="ep-desc">Self-referencing tree structure for hierarchical menu management.</p>
            <div class="ep-path">
                <span class="ep-path-text">/api/admin/menus</span>
                <svg class="ep-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </div>
        </a>

        <a href="/api/admin/roles" class="ep-card" data-reveal target="_blank" rel="noopener" style="--accent:#fd79a8;--accent-bg:rgba(253,121,168,0.08)">
            <div class="ep-head">
                <div class="ep-icon" style="background:var(--accent-bg);color:var(--accent)">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="8.5" cy="7" r="4"/><polyline points="17 11 19 13 23 9"/></svg>
                </div>
                <div class="ep-method ep-method--get">GET</div>
            </div>
            <h3 class="ep-title">Roles</h3>
            <p class="ep-desc">System roles with is_system flag and role-permission mapping.</p>
            <div class="ep-path">
                <span class="ep-path-text">/api/admin/roles</span>
                <svg class="ep-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </div>
        </a>

        <a href="/api/admin/permissions" class="ep-card" data-reveal target="_blank" rel="noopener" style="--accent:#55efc4;--accent-bg:rgba(85,239,196,0.08)">
            <div class="ep-head">
                <div class="ep-icon" style="background:var(--accent-bg);color:var(--accent)">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 22 8.5 22 15.5 12 22 2 15.5 2 8.5"/><line x1="12" y1="22" x2="12" y2="15.5"/><polyline points="22 8.5 12 15.5 2 8.5"/></svg>
                </div>
                <div class="ep-method ep-method--get">GET</div>
            </div>
            <h3 class="ep-title">Permissions</h3>
            <p class="ep-desc">Fine-grained permissions linked to menus with unique code identifiers.</p>
            <div class="ep-path">
                <span class="ep-path-text">/api/admin/permissions</span>
                <svg class="ep-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </div>
        </a>

        <a href="/api/admin/users" class="ep-card" data-reveal target="_blank" rel="noopener" style="--accent:#74b9ff;--accent-bg:rgba(116,185,255,0.08)">
            <div class="ep-head">
                <div class="ep-icon" style="background:var(--accent-bg);color:var(--accent)">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
                </div>
                <div class="ep-method ep-method--get">GET</div>
            </div>
            <h3 class="ep-title">Users</h3>
            <p class="ep-desc">User CRUD with role assignment, linked to Better Auth via auth_user_id.</p>
            <div class="ep-path">
                <span class="ep-path-text">/api/admin/users</span>
                <svg class="ep-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </div>
        </a>
    </div>
</section>

