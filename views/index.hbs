<!-- Server Status -->
<section class="live" data-reveal>
    <div class="live-card">
        <div class="live-row">
            <span class="live-label">Server Status</span>
            <span class="live-val live-val--ok">
                <span class="live-dot"></span>
                Operational
            </span>
        </div>
        <div class="live-row">
            <span class="live-label">Environment</span>
            <code class="live-code">{{NODE_ENV}}</code>
        </div>
        <div class="live-row">
            <span class="live-label">API Prefix</span>
            <code class="live-code">/api</code>
        </div>
        <div class="live-row">
            <span class="live-label">Version</span>
            <code class="live-code">{{nestVersion}}</code>
        </div>
    </div>
</section>
