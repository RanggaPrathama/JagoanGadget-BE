NODE_ENV=development
PORT=3000
APP_NAME=NestJS API
APP_BASE_URL=http://localhost:3000
APP_CORS_ORIGIN=http://localhost:5173
APP_LOGGING_ENABLED=true
LOG_LEVEL=info

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=app_db
DATABASE_SSL=false
DATABASE_LOGGING=false
DATABASE_SYNCHRONIZE=true
# Run `pnpm run seed` to populate menus/permissions/roles (and the superadmin below).
SEED_SUPERADMIN_EMAIL=superadmin@localhost
SEED_SUPERADMIN_NAME=Super Admin
SEED_SUPERADMIN_PASSWORD=Superadmin#1234

BETTER_AUTH_SECRET=change-this-with-a-very-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_API_KEY=
BETTER_AUTH_API_URL=
BETTER_AUTH_KV_URL=

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_TEMP_TTL_HOURS=24
# Optional: full URL prefix for public files. Defaults to {APP_BASE_URL}/api/storage.
# Set this to a bucket/CDN endpoint when using S3/MinIO, e.g. https://cdn.example.com
STORAGE_PUBLIC_URL=
# Optional: default file (avatar) URL used when a column is null.
# Defaults to {APP_BASE_URL}/image/default-user.png
STORAGE_DEFAULT_AVATAR=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=app:rbac

# Metrics (Prometheus)
METRICS_ENABLED=true
